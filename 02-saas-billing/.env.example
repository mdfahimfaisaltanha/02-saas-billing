# --- Required ---------------------------------------------------------------
# Postgres connection string (Neon/Supabase free tier works).
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared secret for signing/verifying billing webhooks (HMAC-SHA256).
# Any long random string. Generate one:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=dev_webhook_secret_change_me

# --- Optional: Stripe (TEST MODE ONLY) ---------------------------------------
# Leave blank to run in built-in MOCK billing mode — charges, failures,
# dunning retries, and webhooks all work end to end with mock references.
# Set a TEST key (sk_test_...) to create real test-mode PaymentIntents for
# invoice charges. Live keys (sk_live_...) are rejected on purpose.
STRIPE_SECRET_KEY=

# Password used for all seeded demo accounts (optional).
SEED_PASSWORD=ChangeMe123!
